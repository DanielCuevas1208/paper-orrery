<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PaperOrrery.Cli</RootNamespace>
    <AssemblyName>paper-orrery</AssemblyName>
    <Description>Command line interface for Paper Orrery.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperOrrery\PaperOrrery.fsproj" />
  </ItemGroup>

</Project>
